# ============================================================
# ERA System — Master Environment Configuration Template
# Copy this file to .env and configure your keys.
# NEVER commit your real .env file to GitHub.
# ============================================================

# ── 1. CORE AI & GEMINI CONFIGURATION ──────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── 2. SERVICE PORTS & NETWORKING ──────────────────────────
PORT=3000
HOST=127.0.0.1
ERA_BRIDGE_PORT=8765
ERA_VISION_PORT=8766
ERA_AGENT_PORT=8000
ERA_BRIDGE_WS_URL=ws://127.0.0.1:8765/ws

# ── 3. SERVICE AUTHENTICATION TOKENS ───────────────────────
# Secret token shared between Bridge, Agent, and Vision
ERA_BRIDGE_SECRET=era_local_bridge_secret_key_change_in_prod
VISION_AGENT_API_KEY=era_vision_agent_internal_key

# ── 4. VOICEGUARD & SECURITY SETTINGS ─────────────────────
VOICEGUARD_ENABLED=true
VOICEGUARD_STRICT_MODE=false
VOICEGUARD_CONFIDENCE_THRESHOLD=0.75

# ── 5. OPTIONAL INTEGRATIONS ──────────────────────────────
# Google OAuth (for Gmail integration in era_agent)
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json

# Vision & OCR Settings
VISION_OCR_ENGINE=tesseract
SCREEN_CAPTURE_FPS=10
