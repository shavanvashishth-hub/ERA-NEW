# ==========================================
# ERA Monorepo Master .gitignore
# ==========================================

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
!.env.template
credentials.json
token.json
keys.enc
*.enc
whatsapp_chats.json
whatsapp_contacts.json

# Node & Frontend (Electron / React)
node_modules/
dist/
dist-electron/
build/
*.asar
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun.lockb

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
python_runtime/

# Runtime Logs, PIDs, Temporary Files
*.log
logs/
logs_services/
*.pid
*.tmp
*.bak
*.backup
*.bak_*
output.txt

# Media / Generated Test Artifacts
*.task
*.onnx
*.weights
workspace/orders/
cam_*.jpg
test_*.jpg
test_*.png
test_after.jpg
test_before.jpg
current_screen.*

# IDE & Editor Configs
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS Generated Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.Spotlight-V100
.Trashes
